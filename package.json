    "test": "node --test fileTools.test.ts",
    "demo": "node demo.ts",
    "smoke": "node mcp-test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "ai-agent",
    "llm-tools",
    "file-editing",
    "code-editing",
    "crlf",
    "oldstring",
    "gemini",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testAccountDeltas/fileTools.git"
  },
  "bugs": {
    "url": "https://github.com/testAccountDeltas/fileTools/issues"
  },
  "homepage": "https://github.com/testAccountDeltas/fileTools#readme",
  "engines": {
    "node": ">=23"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  }
